trigger CountRoundTrigger on Count_Round__c (after insert) {
    List<Id> roundIds = new List<Id>();
    for (Count_Round__c round : Trigger.new) {
        roundIds.add(round.Id);
    }

    System.enqueueJob(new TallyBatchLauncher(roundIds));
}

public class TallyBatchLauncher implements Queueable {
    private List<Id> roundIds;

    public TallyBatchLauncher(List<Id> roundIds) {
        this.roundIds = roundIds;
    }

    public void execute(QueueableContext ctx) {
        for (Id roundId : roundIds) {
            Database.executeBatch(new TallyBatch(roundId), 200);
        }
    }
}

